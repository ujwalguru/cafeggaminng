{
  "buildCommand": "cd ../.. && pnpm --filter @workspace/airavoto-pos run build",
  "outputDirectory": "dist",
  "installCommand": "cd ../.. && pnpm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/live-cafes",
      "destination": "https://airavotoheadcli.onrender.com/api/directory"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
